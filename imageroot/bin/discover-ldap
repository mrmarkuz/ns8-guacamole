#
# Find settings for LDAP service
#

import os
import sys
import json
import agent
from agent.ldapproxy import Ldapproxy

udomname = os.environ.get('LDAP_DOMAIN','')

try:
    odom = Ldapproxy().get_domain(udomname)
    'host' in odom # Throw exception if odom is None
except:
    # During restore the domain could be unavailable. Use a fallback
    # configuration, pointing to nowhere, just to set the variables.
    # Once the domain becomes available, the event will fix them.
    odom = {
        'host': '127.0.0.1',
        'port': 20000,
        'schema': 'rfc2307',
        'location': 'internal',
        'base_dn': 'dc=guacamole,dc=invalid',
        'bind_dn': 'cn=example,dc=guacamole,dc=invalid',
        'bind_password': 'invalid',
    }

tmpfile = "discover.env." + str(os.getpid())

with open(tmpfile, "w") as denv:
    print('GUACAMOLE_LDAP_PORT=' + str(odom['port']), file=denv)
    print('GUACAMOLE_LDAP_USER=' + odom['bind_dn'], file=denv)
    print('GUACAMOLE_LDAP_HOST=' + odom['host'], file=denv)
    print('GUACAMOLE_LDAP_PASS=' + odom['bind_password'], file=denv)
    print('GUACAMOLE_LDAP_SCHEMA=' + odom['schema'], file=denv)
    print('GUACAMOLE_LDAP_BASE=' + odom['base_dn'], file=denv)
    # NEW Write to env file
    print('LDAP_HOSTNAME=10.0.2.2', file=denv)
    print('LDAP_PORT=' + odom['port'], file=denv)
    print('LDAP_SEARCH_BIND_DN=' + odom['bind_dn'], file=denv)
    print('LDAP_SEARCH_BIND_PASSWORD=' + odom['bind_password'], file=denv)
    if odom['schema'] == "rfc2307":
        # OpenLDAP specific:
        print('LDAP_USER_BASE_DN=ou=People,' + odom['base_dn'], file=denv)
        print('LDAP_MEMBER_ATTRIBUTE=memberUid', file=denv)
        print('LDAP_MEMBER_ATTRIBUTE_TYPE=uid', file=denv)
        print('LDAP_GROUP_BASE_DN=ou=Groups,' + odom['base_dn'], file=denv)
    if odom['schema'] == "ad":
        # Samba AD specific:
        print('LDAP_USER_BASE_DN=cn=Users,' + odom['base_dn'], file=denv)
        print('LDAP_GROUP_BASE_DN=cn=Users,' + odom['base_dn'], file=denv)
        print('LDAP_USERNAME_ATTRIBUTE=samaccountname', file=denv)
        print('LDAP_USER_SEARCH_FILTER=(&(objectClass=top)(objectClass=user)(objectClass=person)(objectClass=organizationalPerson))', file=denv)
        print('LDAP_GROUP_SEARCH_FILTER=(&(objectClass=top)(objectClass=group))', file=denv)

os.replace(tmpfile, "ldap.env")
